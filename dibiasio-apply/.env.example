# Port and the public address applicants will use (used to build links)
PORT=5050
PUBLIC_URL=http://localhost:5050

# 32-byte encryption key for applicant data and documents. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACK THIS UP. If it's lost, stored applications cannot be decrypted.
DATA_KEY=

# Where applications and documents are stored (use a persistent disk in production)
DATA_DIR=./data
# Or, on hosts with a mounted disk (Render): use it when present, warn agents when it isn't
# PERSISTENT_DISK=/var/data

# First admin account (created on first start if no agents exist).
# Alternatively leave blank and create it from /agent on first visit.
ADMIN_NAME=James Dibiasio
ADMIN_EMAIL=james@dibiasiorealty.com
ADMIN_PASSWORD=

# Credit check: your screening provider's applicant link (TransUnion SmartMove,
# RentSpree, MyRental, etc.). Shown to applicants after they submit and used for
# one-tap "credit check request" messages in the dashboard.
CREDIT_SCREENING_URL=
CREDIT_PROVIDER_NAME=TransUnion SmartMove

# Optional email alerts to agents when applications / documents arrive.
# Example (Google Workspace app password): smtps://james%40dibiasiorealty.com:APP_PASSWORD@smtp.gmail.com
SMTP_URL=
MAIL_FROM=Dibiasio Realty Applications <james@dibiasiorealty.com>
# Always copy this address on alerts (e.g. office manager)
NOTIFY_EMAIL=

NODE_ENV=development
