# ---------------------------------------------------------------
# Exchange connection (any exchange supported by CCXT works)
#   binanceus  - US users (lists BTC, ETH, SOL, BNB)
#   binance    - non-US users
#   kraken, coinbase, okx, bybit, kucoin ... (check BNB is listed)
# ---------------------------------------------------------------
EXCHANGE=binanceus
QUOTE_CURRENCY=USDT
SYMBOLS=BTC,ETH,SOL,BNB
TIMEFRAME=1h

# API keys are only needed for LIVE trading. Create keys with
# "trade" permission only - NEVER enable withdrawals.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Some exchanges (okx, kucoin, coinbase) also need a passphrase
EXCHANGE_API_PASSWORD=

# ---------------------------------------------------------------
# Trading mode
#   paper - simulated orders against real prices (default, safe)
#   live  - real orders on your exchange account
# Live mode ALSO requires CONFIRM_LIVE_TRADING=yes
# ---------------------------------------------------------------
TRADING_MODE=paper
CONFIRM_LIVE_TRADING=no
PAPER_STARTING_BALANCE=10000

# Automatically act on BUY/SELL signals (otherwise signals only,
# and you click Buy/Sell in the dashboard)
AUTO_TRADE=false
# Automatically sell when a position hits its stop-loss / take-profit
ENFORCE_STOPS=true

# Market data source: exchange (real) or demo (synthetic, offline)
DATA_SOURCE=exchange

# ---------------------------------------------------------------
# Risk management
# ---------------------------------------------------------------
RISK_PER_TRADE_PCT=1        # % of equity lost if the stop-loss is hit
MAX_POSITION_PCT=25         # max % of equity in any one coin
DAILY_LOSS_LIMIT_PCT=5      # stop opening trades after this daily drawdown
MIN_ORDER_SIZE=10           # smallest order in quote currency

# Strategy
#   classic - mixes trend and mean-reversion; fixed ATR take-profit
#   trend   - only buys in uptrends; trailing stop instead of a fixed target
# Run `npm run optimize` to find good values for these on recent history.
STRATEGY_MODE=classic
# Score range is roughly -8..+8
BUY_THRESHOLD=3
SELL_THRESHOLD=-3
STOP_ATR_MULT=2             # initial stop-loss distance in ATRs
TARGET_ATR_MULT=3           # classic: take-profit distance in ATRs
TRAIL_ATR_MULT=3            # trend: trailing stop distance below the highest price

# ---------------------------------------------------------------
# Server / dashboard
# ---------------------------------------------------------------
PORT=4000
HOST=127.0.0.1
# Full re-analysis interval. Signals are also recalculated the moment a
# candle closes, and prices stream live in between.
SCAN_INTERVAL_SEC=60
# Price refresh rate if the exchange's WebSocket stream is unavailable
PRICE_POLL_SEC=2
# If set, POST requests (orders, settings) need this token
DASHBOARD_TOKEN=

# ---------------------------------------------------------------
# Optional signal notifications
# ---------------------------------------------------------------
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
